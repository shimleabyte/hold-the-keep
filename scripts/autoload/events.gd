extends Node
## Signal bus global. Sistem saling bicara lewat sini, bukan lewat get_node.

signal resource_changed(kind: String, amount: int)
signal phase_changed(is_night: bool)
signal day_changed(day: int)
signal build_selected(id: String)  # "" = mode bangun mati
signal building_placed(id: String, cell: Vector2i)
signal building_removed(id: String, cell: Vector2i)
signal building_destroyed(id: String, cell: Vector2i)
signal territory_changed(claimed_tiles: int)
signal region_control_changed(region_id: String, control: String)
signal enemy_stronghold_placed(cell: Vector2i)
signal enemy_stronghold_destroyed(cell: Vector2i)
signal campaign_won(day: int)
signal build_feedback(text: String)
signal player_hp_changed(hp: int, max_hp: int)
signal keep_hp_changed(hp: int, max_hp: int)
signal wave_started(day: int, count: int)
signal stage_changed(stage_id: String, stage_name: String, day: int)
signal enemy_killed(id: String)
signal game_over(day: int)
signal village_changed(pop: int, cap: int, quota: Dictionary, assigned: Dictionary)
signal villager_died()
signal event_triggered(title: String, text: String)
signal game_won(day: int)
signal menu_requested()
signal player_attacked()
signal player_harvested(kind: String)
signal build_request(id: String)
signal job_quota_request(job: String, delta: int)
signal fx_burst(kind: String, pos: Vector2, dir: Vector2, amount: float)
signal screen_shake(strength: float, duration: float)
signal tech_started(id: String)
signal tech_researched(id: String)
signal tech_panel_requested()
