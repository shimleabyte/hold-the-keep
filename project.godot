; Engine configuration file.
config_version=5

[application]

config/name="Hold the Keep"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
Events="*res://scripts/autoload/events.gd"
DataDB="*res://scripts/autoload/data_db.gd"
Settings="*res://scripts/autoload/settings.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Tech="*res://scripts/autoload/tech.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Audio="*res://scripts/autoload/audio.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/initial_position_type=1
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
